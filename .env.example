# Copy this file to `.env` and fill in your keys. Never share or commit `.env`.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 9Router API key (only needed if 9Router answers "Invalid API key"; copy it from the 9Router
# dashboard at http://localhost:20128). Leave empty otherwise.
NINEROUTER_API_KEY=
